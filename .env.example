# ─────────────────────────────────────────────────────────────
# SonicAurora — browser configuration
# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Everything here is VITE_-prefixed, which
# means it is COMPILED INTO THE BUNDLE and publicly visible. Never put a
# secret in this file — the anon key is designed to be public and is safe only
# because row-level security is switched on (see supabase/migrations).

# Supabase project — Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The app owner's auth user id. Unlocks the artist portal (hold the version
# line in About) and grants an owner membership. Find it after your first
# sign-in: Authentication → Users in the Supabase dashboard.
VITE_APP_OWNER_ID=

# Public storage bucket holding the ambient / instrumental beds.
VITE_AUDIO_BUCKET=app-audio

# ─────────────────────────────────────────────────────────────
# Edge Function secrets — NOT set here
# ─────────────────────────────────────────────────────────────
# These are server-side and must never reach the browser. Set them with the
# CLI instead:
#
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_…
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_…
#   supabase secrets set APP_ORIGIN=https://your-app-domain
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically — do not set them by hand.
